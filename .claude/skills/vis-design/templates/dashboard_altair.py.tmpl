# ---------------------------------------------------------------- CONFIG
_HERE = os.path.dirname(os.path.abspath(__file__))
DATA_PATH = os.path.join(_HERE, "{{DATA_PATH}}")   # script-relative; overridable with --data
OUT_DIR = "{{OUT_DIR}}"              # overridable with --out-dir
