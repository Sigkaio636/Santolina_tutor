{
  "extraKnownMarketplaces": {
    "stellarshenson-marketplace": {
      "source": {
        "source": "github",
        "repo": "stellarshenson/claude-code-plugins"
      }
    }
  },
  "enabledPlugins": {
    "devils-advocate@stellarshenson-marketplace": true,
    "svg-infographics@stellarshenson-marketplace": true,
    "document-processing@stellarshenson-marketplace": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/m3kang-guard.py"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-gate.sh"
          }
        ]
      }
    ]
  }
}
