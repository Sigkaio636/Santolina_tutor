def save(fig: go.Figure, out_dir: str, slug: str) -> list[str]:
    os.makedirs(out_dir, exist_ok=True)
    written = []
    html = os.path.join(out_dir, f"{slug}.html")
    fig.write_html(html, include_plotlyjs="cdn")
    written.append(html)
    js = os.path.join(out_dir, f"{slug}.json")
    fig.write_json(js)
    written.append(js)
    try:
        png = os.path.join(out_dir, f"{slug}.png")
        fig.write_image(png, scale=2)
        written.append(png)
    except Exception as e:  # kaleido missing
        print(f"PNG not rendered ({e}); open the HTML in a browser", file=sys.stderr)
    return written


def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("--data", default=DATA_PATH)
    ap.add_argument("--out-dir", default=OUT_DIR)
    ap.add_argument("--no-show", action="store_true")
    args, _unknown = ap.parse_known_args(argv)  # tolerate a foreign argv (inspectors)
    df = derive(load(args.data))
    fig = build_chart(df)
    for f in save(fig, args.out_dir, SLUG):
        print("wrote", f)
    return fig


if __name__ == "__main__":
    fig = main()
